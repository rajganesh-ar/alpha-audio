# Copy to .env for local development. Every variable here is validated at startup by
# packages/config/env.ts; the app refuses to boot on a missing or malformed value.

# NODE_ENV is not set here: next dev, next build and vitest set it themselves.
# Setting it (for example NODE_ENV=development before `next build`) breaks production builds.

# Postgres (docker compose provides this locally; pgvector image)
DATABASE_URL=postgres://alpha:alpha@localhost:5432/alpha

# Payload: used to sign sessions. Generate with `openssl rand -hex 32`.
PAYLOAD_SECRET=change-me-to-a-random-64-hex-string-before-first-boot

# Public origin of this app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Object storage: MinIO locally, Cloudflare R2 in cloud (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=alpha-media
S3_ACCESS_KEY_ID=alpha
S3_SECRET_ACCESS_KEY=alpha-secret
S3_FORCE_PATH_STYLE=true

# Optional: transactional email (Mailpit locally)
SMTP_URL=smtp://localhost:1025
