{
  "name": "@alpha/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm fonts && next dev",
    "build": "pnpm fonts && next build",
    "start": "next start",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed:markets": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-markets.ts",
    "fonts": "alpha-sync-fonts public/fonts",
    "seed:inventory": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-demo-inventory.ts"
  },
  "dependencies": {
    "@alpha/config": "workspace:*",
    "@alpha/core": "workspace:*",
    "@alpha/payload": "workspace:*",
    "@alpha/ui": "workspace:*",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@tailwindcss/postcss": "4.3.3",
    "cross-env": "^7.0.3",
    "graphql": "^16.11.0",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.0",
    "tailwindcss": "4.3.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "pg": "^8.16.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.0"
  }
}
