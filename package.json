{
  "name": "alpha-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "docker compose up -d && turbo run dev --filter=@alpha/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:a11y": "turbo run test:a11y",
    "generate:types": "pnpm --filter @alpha/web exec payload generate:types",
    "check": "turbo run typecheck lint test test:integration test:a11y",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:visual": "turbo run test:visual"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.8"
  }
}
